---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { ADSENSE_CLIENT } from "../adsense";
import { ANALYTICS_ID } from "../analytics";
import { navTracks, pageHref } from "../nav";
import { SITE_NAME, SITE_DESCRIPTION, AUTHOR, OG_IMAGE } from "../seo";
import "../styles/global.css";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  /** Trail shown above the page heading. "Home" is prepended automatically. */
  crumbs?: Crumb[];
  /**
   * Overrides the <title> without touching the visible heading, for pages
   * whose in-site name ("Graphics") is not what someone would search for.
   */
  seoTitle?: string;
  /** Page-specific JSON-LD, merged with the site-wide graph. */
  schema?: Record<string, unknown>;
}

const { title, description, crumbs = [], seoTitle, schema } = Astro.props;
const base = import.meta.env.BASE_URL;

// Tracks, their sections, groups and chapters, in the one order the pager at
// the foot of each page walks as well.
const trackList = await navTracks();
const sectionList = trackList.flatMap((track) => track.sections);

// Emitted by `zig build`; states the compiler that actually verified the
// snippets rather than a version hardcoded here.
let zigVersion = "master";
let snippetCount = 0;
try {
  const info = JSON.parse(
    await readFile(resolve(process.cwd(), "public/wasm/build-info.json"), "utf8"),
  );
  zigVersion = info.zigVersion;
  snippetCount = info.snippetCount;
} catch {
  // Site can still build before `zig build` has run; the footer degrades.
}

const current = Astro.url.pathname;
const trail: Crumb[] = [{ label: "Home", href: base }, ...crumbs];

// Absolute URLs for every tag a crawler or link preview reads. `Astro.site`
// carries the deploy origin (the custom domain, or a github.io project site
// with its path prefix), so these follow the same switch as every internal
// link instead of hardcoding a host that would go stale on a move.
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(current);
const pageTitle = seoTitle ?? title;
const headTitle = pageTitle === SITE_NAME ? pageTitle : `${pageTitle} · ${SITE_NAME}`;
const metaDescription = description ?? SITE_DESCRIPTION;

// One JSON-LD graph per page: the site itself, the trail that leads here, and
// whatever the page is (a chapter, a collection of chapters). Google reads the
// breadcrumb to render the path under the result instead of a bare URL.
const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${abs(base)}#website`,
    name: SITE_NAME,
    url: abs(base),
    description: SITE_DESCRIPTION,
    inLanguage: "en",
    author: { "@type": "Person", name: AUTHOR },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: trail.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.label === "Home" ? SITE_NAME : crumb.label,
      item: crumb.href ? abs(crumb.href) : canonical,
    })),
  },
  // The page only knows what kind of thing it is; the layout is what knows
  // where it lives, so the URL fields are filled in here rather than repeated
  // at every call site where they could disagree with the canonical.
  ...(schema
    ? [
        {
          ...schema,
          url: canonical,
          mainEntityOfPage: canonical,
          isPartOf: { "@id": `${abs(base)}#website` },
        },
      ]
    : []),
];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

// Exactly one section is expanded: the one the reader is in, falling back to
// the first. Pages outside the chapters (home, privacy) match nothing, and a
// sidebar of entirely closed headings gives a first-time reader nothing to
// click.
const openSlug =
  sectionList.find((section) => current.includes(`/${section.slug}/`))?.slug ??
  sectionList[0]?.slug;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{headTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={AUTHOR} />

    {/* Link previews. og:image is absolute because Slack, X and iMessage
        resolve it against nothing. */}
    <meta property="og:type" content={schema?.["@type"] === "TechArticle" ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={headTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(`${base}${OG_IMAGE}`)} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rajeshpillai" />
    <meta name="twitter:creator" content="@rajeshpillai" />
    <meta name="twitter:title" content={headTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={abs(`${base}${OG_IMAGE}`)} />

    {/* Before the first byte of body is painted, and before the stylesheet
        resolves a single `light-dark()`. A deferred module would run after
        first paint and every page would flash the other theme. Nothing here
        is required: with JS off `color-scheme: light dark` follows the
        reader's system setting, and the toggle never appears. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        // Private mode: the system setting decides, which is the default.
      }
    </script>

    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    {/* Ads are opt-in: with no publisher id configured nothing third-party is
        loaded at all. The meta tag is how AdSense verifies ownership of the
        domain; the script is the auto-ads loader, and placement is controlled
        from the AdSense dashboard rather than from markup here. */}
    {
      ADSENSE_CLIENT && (
        <>
          <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
          {/* `is:inline` keeps Astro from treating this as a script to bundle,
              which would move it out of <head> where AdSense expects it. */}
          <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
            crossorigin="anonymous"
          />
        </>
      )
    }

    {/* Analytics are opt-in on the same terms as the ads: with no measurement
        id configured nothing is loaded. Astro builds every page as its own
        document, so there is no client-side routing for gtag to miss; the
        default page_view on load counts every navigation. */}
    {
      ANALYTICS_ID && (
        <>
          {/* `is:inline` on both, for the same reason as the ad loader: the
              config block must run in <head> after the loader tag, and a
              bundled module would be hoisted out of order. */}
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS_ID}`}
          />
          <script is:inline define:vars={{ ANALYTICS_ID }}>
            // Google's snippet declares `function gtag()`, but `define:vars`
            // wraps this block in an IIFE, which would scope that declaration
            // out of the global namespace. Pageviews would still work (the
            // loader reads `dataLayer` itself), while any later
            // `gtag("event", …)` call would throw. Assign to `window`.
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", ANALYTICS_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    {/* Checkbox, not a button: the drawer works with JS off. Must precede
        `.shell` so CSS can reach the sidebar as a sibling. */}
    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Show chapters" />

    {/* The same trick for the permanent sidebar on wide screens: checked means
        folded away, giving the chapter the full width. */}
    <input
      class="rail-toggle"
      type="checkbox"
      id="rail-toggle"
      aria-label="Show or hide the chapter sidebar"
    />
    {/* Inline and unbundled, so the reader's last choice is applied before the
        sidebar is parsed. A deferred module would run after first paint and
        the sidebar would visibly flash open on every page. */}
    <script is:inline>
      try {
        if (localStorage.getItem("nav-rail") === "closed") {
          document.getElementById("rail-toggle").checked = true;
        }
      } catch {
        // Private mode: the sidebar just starts open.
      }
    </script>

    <header class="topbar">
      <label class="nav-button" for="nav-toggle">
        <svg class="nav-open" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M1 3h14v2H1V3Zm0 4h14v2H1V7Zm0 4h14v2H1v-2Z"></path>
        </svg>
        <svg class="nav-close" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M2.34 3.76 3.76 2.34 8 6.59l4.24-4.25 1.42 1.42L9.41 8l4.25 4.24-1.42 1.42L8 9.41l-4.24 4.25-1.42-1.42L6.59 8 2.34 3.76Z"></path>
        </svg>
        Chapters
      </label>

      {/* Wide screens only; below 860px the drawer button above is the control.
          The word stays put and only the icon changes, so the brand beside it
          does not jump when the sidebar folds. */}
      <label class="rail-button" for="rail-toggle" title="Show or hide the chapter sidebar">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <rect
            x="1.5"
            y="2.5"
            width="13"
            height="11"
            rx="1.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
          ></rect>
          <path class="rail-fill" d="M2.9 3.9h2.7v8.2H2.9z" fill="currentColor"></path>
        </svg>
        Chapters
      </label>
      <div class="brand-wrap">
        <a class="brand" href={base}>⚡ {SITE_NAME}</a>
        {/* This lives on ziglang.in, one letter from the official ziglang.org;
            say plainly that it is not affiliated. */}
        <a
          class="unofficial"
          href="https://ziglang.org"
          target="_blank"
          rel="noopener noreferrer"
          title="Independent community guide. Not affiliated with the Zig Software Foundation; the official site is ziglang.org."
        >
          Unofficial
        </a>
        {/* The other half of the sentence. Unaffiliated is a caveat; verified
            is the answer to it, and the two only mean something together. */}
        <span
          class="verified"
          title={`Every one of the ${snippetCount} snippets on this site was compiled and run by CI against Zig ${zigVersion}. If one stopped working, the build would be red and this page would not have published.`}
        >
          but fully verified
        </span>
      </div>

      {/* Progressive enhancement: with JS off this is an inert text field that
          does nothing, so it stays hidden until the script wires it up. */}
      <div class="search" hidden>
        <svg class="search-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
          <path d="M11.74 10.34a6 6 0 1 0-1.4 1.4l3.2 3.2 1.4-1.4-3.2-3.2ZM7 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z"></path>
        </svg>
        <input
          class="search-input"
          type="search"
          placeholder="Search chapters…"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-hint">/</kbd>
        <div class="search-results" id="search-results" role="listbox" aria-label="Search results" hidden></div>
      </div>

      <span class="version" title="Every snippet in this guide is compiled and run against this exact compiler, in CI and in your browser">
        ✓ Zig {zigVersion}
      </span>
      <a class="topbar-link" href={pageHref("getting-started/coming-from-older-zig")}>
        On an older Zig?
      </a>

      {/* Hidden until the script wires it up, the same contract the search box
          keeps: an inert control that does nothing is worse than no control.
          With JS off the theme still follows the system, so nothing is lost.
          The icon shows the theme you would switch to, and the label says so,
          which is the only reading of a lone sun that is not ambiguous. */}
      <button class="theme-toggle" type="button" hidden aria-label="Switch theme">
        <svg class="theme-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.06-1.06a.75.75 0 0 1 1.06 0Zm-9.193 9.193a.75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3 8a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 3 8Zm13 0a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8Zm-8 5a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.06-1.06a.75.75 0 0 1 0-1.06Zm9.193 9.193a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061Z"></path>
        </svg>
        <svg class="theme-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z"></path>
        </svg>
      </button>
    </header>

    <div class="shell">
      <nav class="sidebar" aria-label="Chapters">
        {
          /* Track headings are labels, not links: a track has no page of its
             own, on purpose, so it adds no URL and no stop to the pager. */
          trackList.map((track) => (
          <>
          <p class="nav-track">{track.title}</p>
          {track.sections.map((section) => (
            /* Open one section only, so the phone drawer starts as a short
               list rather than every chapter at once. */
            <details
              class="nav-group"
              data-nav-key={section.slug}
              open={section.slug === openSlug}
            >
              <summary>{section.title}</summary>
              <ul>
                <li>
                  <a
                    class="nav-overview"
                    href={pageHref(section.slug)}
                    aria-current={current.endsWith(`/${section.slug}/`) ? "page" : undefined}
                  >
                    Overview
                  </a>
                </li>
                {section.groups.map(({ label, slug: groupSlug, members }) =>
                  label ? (
                    /* A library gets its own collapsible node with an
                       overview page, so its chapters read as one unit. */
                    <li>
                      <details
                        class="nav-subgroup"
                        data-nav-key={groupSlug}
                        open={current.includes(`/${groupSlug}/`)}
                      >
                        <summary>{label}</summary>
                        <ul>
                          <li>
                            <a
                              class="nav-overview"
                              href={pageHref(groupSlug)}
                              aria-current={
                                current.endsWith(`/${groupSlug}/`) ? "page" : undefined
                              }
                            >
                              Overview
                            </a>
                          </li>
                          {members.map((entry) => (
                            <li>
                              <a
                                href={pageHref(entry.id)}
                                aria-current={
                                  current.endsWith(`/${entry.id}/`) ? "page" : undefined
                                }
                              >
                                {entry.data.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ) : (
                    members.map((entry) => (
                      <li>
                        <a
                          href={pageHref(entry.id)}
                          aria-current={current.endsWith(`/${entry.id}/`) ? "page" : undefined}
                        >
                          {entry.data.title}
                        </a>
                      </li>
                    ))
                  ),
                )}
              </ul>
            </details>
          ))}
          </>
          ))
        }

        <p class="nav-aside">
          <a href={pageHref("getting-started/coming-from-older-zig")}>On an older Zig?</a>
        </p>
      </nav>

      <main>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {
              trail.map((crumb, i) => (
                <li>
                  {crumb.href && i < trail.length - 1 ? (
                    <a href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span aria-current="page">{crumb.label}</span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <slot />
      </main>
    </div>

    <footer class="statusbar">
      <span class="status-item">
        <strong>Zig {zigVersion}</strong>
        <span class="status-sub">→ all {snippetCount} snippets compiled and run against this build</span>
      </span>

      <span class="status-item">
        <span class="status-sub">
          syntax and practices follow{" "}
          <a
            href="https://codeberg.org/ziglang/zig"
            target="_blank"
            rel="noopener noreferrer"
          >upstream Zig on Codeberg</a>
        </span>
      </span>

      <span class="status-item">
        <span class="status-sub">
          an unofficial community guide, not affiliated with the Zig Software
          Foundation (<a
            href="https://ziglang.org"
            target="_blank"
            rel="noopener noreferrer"
          >ziglang.org</a>)
        </span>
      </span>

      <span class="status-item status-credit">
        Developed by <strong>Rajesh Pillai</strong>
      </span>


      <span class="status-item status-links">
        <a
          href="https://github.com/rajeshpillai/zig-guide"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          rajeshpillai/zig-guide
        </a>
        <a href="https://twitter.com/rajeshpillai" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path
              d="M9.52 6.78 15.48 0h-1.41L8.89 5.89 4.76 0H0l6.25 8.9L0 16h1.41l5.47-6.22L11.24 16H16L9.52 6.78Zm-1.94 2.2-.63-.89L1.92 1.04h2.17l4.07 5.7.63.89 5.29 7.41h-2.17L7.58 8.98Z"
            ></path>
          </svg>
          @rajeshpillai
        </a>
        {/* Not in the sidebar: that is the list of chapters, and this is a view
            of it rather than a stop in it. Here it is on every page instead. */}
        <a href={`${base}paths/`}>Reading paths</a>
        <a href={`${base}privacy/`}>Privacy</a>
      </span>
    </footer>

    <script>
      import "../scripts/copy-code.ts";
      import "../scripts/search.ts";
      import "../scripts/nav-state.ts";
      import "../scripts/theme.ts";
    </script>
  </body>
</html>
