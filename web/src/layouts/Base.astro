---
import { getCollection } from "astro:content";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import "../styles/global.css";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  /** Trail shown above the page heading. "Home" is prepended automatically. */
  crumbs?: Crumb[];
}

const SITE_NAME = "Zig Guide Live";

const { title, description, crumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

const docs = await getCollection("docs");
const sections = new Map<string, { slug: string; entries: typeof docs }>();
for (const doc of docs.sort((a, b) => a.data.order - b.data.order)) {
  const slug = doc.id.split("/")[0];
  const bucket = sections.get(doc.data.section) ?? { slug, entries: [] };
  bucket.entries.push(doc);
  sections.set(doc.data.section, bucket);
}

/**
 * Split a section's entries into the ungrouped run followed by one bucket
 * per `group` label, preserving order within each. Sections without groups
 * come back as a single unlabelled bucket, so the common case renders as
 * before.
 */
function grouped(entries: typeof docs) {
  const buckets = new Map<string, typeof docs>();
  for (const entry of entries) {
    const key = entry.data.group ?? "";
    (buckets.get(key) ?? buckets.set(key, []).get(key)!).push(entry);
  }
  // Ungrouped first, then groups in first-appearance order.
  return [...buckets.entries()].sort((a, b) => (a[0] === "" ? -1 : b[0] === "" ? 1 : 0));
}

// Emitted by `zig build`; states the compiler that actually verified the
// snippets rather than a version hardcoded here.
let zigVersion = "master";
let snippetCount = 0;
try {
  const info = JSON.parse(
    await readFile(resolve(process.cwd(), "public/wasm/build-info.json"), "utf8"),
  );
  zigVersion = info.zigVersion;
  snippetCount = info.snippetCount;
} catch {
  // Site can still build before `zig build` has run; the footer degrades.
}

const current = Astro.url.pathname;
const trail: Crumb[] = [{ label: "Home", href: base }, ...crumbs];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    {/* Checkbox, not a button: the drawer works with JS off. Must precede
        `.shell` so CSS can reach the sidebar as a sibling. */}
    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Show chapters" />

    <header class="topbar">
      <label class="nav-button" for="nav-toggle">
        <svg class="nav-open" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M1 3h14v2H1V3Zm0 4h14v2H1V7Zm0 4h14v2H1v-2Z"></path>
        </svg>
        <svg class="nav-close" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M2.34 3.76 3.76 2.34 8 6.59l4.24-4.25 1.42 1.42L9.41 8l4.25 4.24-1.42 1.42L8 9.41l-4.24 4.25-1.42-1.42L6.59 8 2.34 3.76Z"></path>
        </svg>
        Chapters
      </label>
      <a class="brand" href={base}>⚡ {SITE_NAME}</a>
      <span class="version" title="Every snippet is compiled and run against this compiler">
        Zig {zigVersion}
      </span>
      <a class="topbar-link" href={`${base}getting-started/coming-from-older-zig/`}>
        On an older Zig?
      </a>
    </header>

    <div class="shell">
      <nav class="sidebar" aria-label="Chapters">
        {
          [...sections].map(([section, { slug, entries }]) => (
            /* Open only the section the reader is in, so the phone drawer
               starts as a short list rather than every chapter at once. */
            <details class="nav-group" open={current.includes(`/${slug}/`)}>
              <summary>{section}</summary>
              <ul>
                <li>
                  <a
                    class="nav-overview"
                    href={`${base}${slug}/`}
                    aria-current={current.endsWith(`/${slug}/`) ? "page" : undefined}
                  >
                    Overview
                  </a>
                </li>
                {grouped(entries).map(([label, members]) => (
                  <>
                    {label && <li class="nav-subgroup">{label}</li>}
                    {members.map((entry) => (
                      <li>
                        <a
                          href={`${base}${entry.id}/`}
                          aria-current={current.endsWith(`/${entry.id}/`) ? "page" : undefined}
                        >
                          {entry.data.title}
                        </a>
                      </li>
                    ))}
                  </>
                ))}
              </ul>
            </details>
          ))
        }

        <p class="nav-aside">
          <a href={`${base}getting-started/coming-from-older-zig/`}>On an older Zig?</a>
        </p>
      </nav>

      <main>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {
              trail.map((crumb, i) => (
                <li>
                  {crumb.href && i < trail.length - 1 ? (
                    <a href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span aria-current="page">{crumb.label}</span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <slot />
      </main>
    </div>

    <footer class="statusbar">
      <span class="status-item">
        <strong>Zig {zigVersion}</strong>
        <span class="status-sub">{snippetCount} snippets verified</span>
      </span>

      <span class="status-item">
        <span class="status-sub">
          syntax and practices follow{" "}
          <a
            href="https://codeberg.org/ziglang/zig"
            target="_blank"
            rel="noopener noreferrer"
          >upstream Zig on Codeberg</a>
        </span>
      </span>

      <span class="status-item status-credit">
        Developed by <strong>Rajesh Pillai</strong>
      </span>

      <span class="status-item status-links">
        <a
          href="https://github.com/rajeshpillai/zig-guide"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          rajeshpillai/zig-guide
        </a>
        <a href="https://twitter.com/rajeshpillai" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path
              d="M9.52 6.78 15.48 0h-1.41L8.89 5.89 4.76 0H0l6.25 8.9L0 16h1.41l5.47-6.22L11.24 16H16L9.52 6.78Zm-1.94 2.2-.63-.89L1.92 1.04h2.17l4.07 5.7.63.89 5.29 7.41h-2.17L7.58 8.98Z"
            ></path>
          </svg>
          @rajeshpillai
        </a>
      </span>
    </footer>

    <script>
      import "../scripts/copy-code.ts";
    </script>
  </body>
</html>
