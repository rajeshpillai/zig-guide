---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Playground from "../components/Playground.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  // One page per chapter.
  const paths = docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, section: null },
  }));

  // Plus an index per section, so the breadcrumb's middle link resolves.
  const sections = new Map();
  for (const doc of docs) {
    const slug = doc.id.split("/")[0];
    const bucket = sections.get(slug) ?? { title: doc.data.section, slug, entries: [] };
    bucket.entries.push(doc);
    sections.set(slug, bucket);
  }
  for (const [slug, bucket] of sections) {
    bucket.entries.sort((a, b) => a.data.order - b.data.order);
    paths.push({ params: { slug }, props: { entry: null, section: bucket } });
  }

  // And an index per group (a library under Building Libraries), living at
  // the group's directory, so the sidebar node and breadcrumb both resolve.
  const groups = new Map();
  for (const doc of docs) {
    if (!doc.data.group) continue;
    const slug = doc.id.split("/").slice(0, -1).join("/");
    const bucket = groups.get(slug) ?? {
      title: doc.data.group,
      slug,
      sectionTitle: doc.data.section,
      sectionSlug: doc.id.split("/")[0],
      entries: [],
    };
    bucket.entries.push(doc);
    groups.set(slug, bucket);
  }
  for (const [slug, bucket] of groups) {
    bucket.entries.sort((a, b) => a.data.order - b.data.order);
    paths.push({ params: { slug }, props: { entry: null, section: null, group: bucket } });
  }

  return paths;
}

const { entry, section, group = null } = Astro.props;
const base = import.meta.env.BASE_URL;

/** Ungrouped chapters first, then one labelled bucket per `group`. */
function grouped(entries: typeof section.entries) {
  const buckets = new Map();
  for (const doc of entries) {
    const key = doc.data.group ?? "";
    (buckets.get(key) ?? buckets.set(key, []).get(key)).push(doc);
  }
  return [...buckets.entries()].sort((a, b) => (a[0] === "" ? -1 : b[0] === "" ? 1 : 0));
}

// Only chapters have MDX bodies to render.
const Content = entry ? (await render(entry)).Content : null;

const crumbs = section
  ? [{ label: section.title }]
  : group
    ? [
        { label: group.sectionTitle, href: `${base}${group.sectionSlug}/` },
        { label: group.title },
      ]
    : [
        { label: entry.data.section, href: `${base}${entry.id.split("/")[0]}/` },
        ...(entry.data.group
          ? [
              {
                label: entry.data.group,
                href: `${base}${entry.id.split("/").slice(0, -1).join("/")}/`,
              },
            ]
          : []),
        { label: entry.data.title },
      ];
---

<Base
  title={section ? section.title : group ? group.title : entry.data.title}
  description={section
    ? `${section.entries.length} chapters on ${section.title}.`
    : group
      ? `${group.entries.length} chapters on ${group.title}.`
      : entry.data.description}
  crumbs={crumbs}
>
  {
    group ? (
      <article>
        <h1>{group.title}</h1>
        <p class="section-lede">{group.entries.length} chapters.</p>
        <ul class="section-index">
          {group.entries.map((chapter) => (
            <li>
              <a href={`${base}${chapter.id}/`}>{chapter.data.title}</a>
              {chapter.data.description && <span>{chapter.data.description}</span>}
            </li>
          ))}
        </ul>
      </article>
    ) : section ? (
      <article>
        <h1>{section.title}</h1>
        <p class="section-lede">{section.entries.length} chapters.</p>
        {
          grouped(section.entries).map(([label, members]) => (
            <>
              {label && (
                <h2 class="section-group">
                  <a href={`${base}${members[0].id.split("/").slice(0, -1).join("/")}/`}>
                    {label}
                  </a>
                </h2>
              )}
              <ul class="section-index">
                {members.map((chapter) => (
                  <li>
                    <a href={`${base}${chapter.id}/`}>{chapter.data.title}</a>
                    {chapter.data.description && <span>{chapter.data.description}</span>}
                  </li>
                ))}
              </ul>
            </>
          ))
        }
      </article>
    ) : (
      <article>
        <h1>{entry.data.title}</h1>
        <Content components={{ Playground }} />
      </article>
    )
  }
</Base>
