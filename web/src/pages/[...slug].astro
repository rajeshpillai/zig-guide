---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Playground from "../components/Playground.astro";
import { guideHref, guideRoute, navSections, neighbours, pageHref, readingOrder } from "../nav";
import { datesFor, newest } from "../git-dates";
import { SECTIONS, GROUPS, SITE_NAME, AUTHOR } from "../seo";

export async function getStaticPaths() {
  const sections = await navSections();
  const paths = [];

  for (const section of sections) {
    // An index per section, so the breadcrumb's middle link resolves.
    paths.push({ params: { slug: guideRoute(section.slug) }, props: { entry: null, section } });

    for (const bucket of section.groups) {
      // And an index per group (a library under Building Libraries), living at
      // the group's directory, so the sidebar node and breadcrumb both resolve.
      if (bucket.label) {
        paths.push({
          params: { slug: guideRoute(bucket.slug) },
          props: {
            entry: null,
            section: null,
            group: {
              title: bucket.label,
              slug: bucket.slug,
              sectionTitle: section.title,
              sectionSlug: section.slug,
              members: bucket.members,
            },
          },
        });
      }

      // One page per chapter.
      for (const entry of bucket.members) {
        paths.push({ params: { slug: guideRoute(entry.id) }, props: { entry, section: null } });
      }
    }
  }

  return paths;
}

const { entry, section, group = null } = Astro.props;

/** Every chapter under an index page, in sidebar order. */
const indexChapters = section
  ? section.groups.flatMap((bucket) => bucket.members)
  : group
    ? group.members
    : [];

// Only chapters have MDX bodies to render.
const Content = entry ? (await render(entry)).Content : null;

// Where this page sits in the guide. Both ends are absent on exactly one page
// each, so a reader can walk the whole guide with the pager alone.
const { prev, next } = neighbours(
  readingOrder(await navSections()),
  entry ? entry.id : (section ?? group).slug,
);

// "Guide" is the first stop on every trail below the site root, because every
// page this route builds lives under one segment and the reader should be able
// to climb back out of a chapter to the chapter list in one click.
const guideCrumb = { label: "Guide", href: guideHref };

const crumbs = section
  ? [guideCrumb, { label: section.title }]
  : group
    ? [
        guideCrumb,
        { label: group.sectionTitle, href: pageHref(group.sectionSlug) },
        { label: group.title },
      ]
    : [
        guideCrumb,
        { label: entry.data.section, href: pageHref(entry.id.split("/")[0]) },
        ...(entry.data.group
          ? [
              {
                label: entry.data.group,
                href: pageHref(entry.id.split("/").slice(0, -1).join("/")),
              },
            ]
          : []),
        { label: entry.data.title },
      ];

// Hand-written copy for an index page, when there is any. A section without an
// entry still gets a page; it just falls back to the chapter count, which is
// what every index read before this existed.
const meta = section ? SECTIONS[section.slug] : group ? GROUPS[group.slug] : null;
const indexCount = indexChapters.length;

/**
 * Takeaways name identifiers (`?T`, `errdefer`, `[*c]T`), and a takeaway that
 * cannot say `+%` without it being read as prose is a takeaway that gets
 * written vaguely instead. Backticks in `seo.ts` become <code>, and nothing
 * else in the string is treated as markup: it is escaped first, so the copy
 * stays plain strings rather than a second content format to maintain.
 */
const inlineCode = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");

/**
 * What this page is, for a crawler. A chapter is a TechArticle; an index is a
 * CollectionPage listing the chapters under it, which is how a search result
 * for "zig cookbook" can show the recipes rather than just the page title.
 */
// From git, not from the build clock: this site rebuilds nightly whether or not
// a word changed, and a `dateModified` that advances every morning is a claim
// Google is entitled to stop believing. An index page has no file of its own,
// so it is as new as the newest chapter it lists.
const dates = entry
  ? await datesFor(entry.filePath ?? "")
  : undefined;
const indexModified = entry
  ? undefined
  : newest(await Promise.all(indexChapters.map((c) => datesFor(c.filePath ?? ""))));

const schema = entry
  ? {
      "@type": "TechArticle",
      headline: entry.data.title,
      description: entry.data.description,
      inLanguage: "en",
      author: { "@type": "Person", name: AUTHOR },
      publisher: { "@type": "Organization", name: SITE_NAME },
      articleSection: entry.data.section,
      proficiencyLevel: "Beginner",
      ...(dates ? { datePublished: dates.published, dateModified: dates.modified } : {}),
    }
  : {
      "@type": "CollectionPage",
      name: (section ?? group).title,
      description: meta?.description,
      ...(indexModified ? { dateModified: indexModified } : {}),
      hasPart: indexChapters.map((chapter) => ({
        "@type": "TechArticle",
        name: chapter.data.title,
        description: chapter.data.description,
        url: new URL(pageHref(chapter.id), Astro.site).href,
      })),
    };
---

<Base
  title={section ? section.title : group ? group.title : entry.data.title}
  seoTitle={meta?.seoTitle}
  description={meta?.description ??
    (section || group
      ? `${indexCount} chapters on ${(section ?? group).title}.`
      : entry.data.description)}
  crumbs={crumbs}
  schema={schema}
  markdown={entry ? `${pageHref(entry.id).replace(/\/$/, "")}.md` : undefined}
>
  {
    group ? (
      <article>
        <h1>{group.title}</h1>
        {meta && <p class="section-intro">{meta.lede}</p>}
        {meta?.note && <p class="section-note" set:html={inlineCode(meta.note)} />}
        {
          /* Same treatment as a section index below. A group index is the page
             a reader lands on from a search for the topic, so leaving it as a
             lede and a list of links makes the one page that has to sell the
             group the thinnest page in it. */
          meta?.takeaways && (
            <ol class="takeaways">
              {meta.takeaways.map((point) => (
                <li set:html={inlineCode(point)} />
              ))}
            </ol>
          )
        }
        <p class="section-lede">{indexCount} chapters.</p>
        <ul class="section-index">
          {group.members.map((chapter) => (
            <li>
              <a href={pageHref(chapter.id)}>{chapter.data.title}</a>
              {chapter.data.description && <span>{chapter.data.description}</span>}
            </li>
          ))}
        </ul>
      </article>
    ) : section ? (
      <article>
        <h1>{section.title}</h1>
        {meta && <p class="section-intro">{meta.lede}</p>}
        {
          /* A limit on how to read the code, so it sits with the description of
             what the section is rather than down among the conclusions. */
          meta?.note && <p class="section-note" set:html={inlineCode(meta.note)} />
        }
        {
          /* Conclusions before the chapter list, so a reader deciding whether
             to spend an evening in this section can see what it buys them. */
          meta?.takeaways && (
            <ol class="takeaways">
              {meta.takeaways.map((point) => (
                <li set:html={inlineCode(point)} />
              ))}
            </ol>
          )
        }
        <p class="section-lede">{indexCount} chapters.</p>
        {
          section.groups.map(({ label, slug: groupSlug, members }) => (
            <>
              {label && (
                <h2 class="section-group">
                  <a href={pageHref(groupSlug)}>{label}</a>
                </h2>
              )}
              <ul class="section-index">
                {members.map((chapter) => (
                  <li>
                    <a href={pageHref(chapter.id)}>{chapter.data.title}</a>
                    {chapter.data.description && <span>{chapter.data.description}</span>}
                  </li>
                ))}
              </ul>
            </>
          ))
        }
      </article>
    ) : (
      <article>
        <h1>{entry.data.title}</h1>
        <Content components={{ Playground }} />
      </article>
    )
  }

  {/* The same order the sidebar lists, so following "next" from the first page
      reaches every page in the guide exactly once. */}
  <nav class="pager" aria-label="Chapter">
    {
      prev && (
        <a class="pager-link pager-prev" href={prev.href} rel="prev">
          <span class="pager-dir">← Previous</span>
          <span class="pager-kicker">{prev.kicker}</span>
          <span class="pager-title">{prev.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="pager-link pager-next" href={next.href} rel="next">
          <span class="pager-dir">Next →</span>
          <span class="pager-kicker">{next.kicker}</span>
          <span class="pager-title">{next.title}</span>
        </a>
      )
    }
  </nav>
</Base>
