---
/**
 * The site root.
 *
 * Deliberately not the chapter list: that is `/learn/`, and duplicating it
 * here would leave two pages competing for the same searches with the same
 * words. This page says what the site is and what the promise costs to keep,
 * and hands off. It is also the page that has room to grow when something on
 * this domain is not a chapter.
 */
import Base from "../layouts/Base.astro";
import { navTracks, guideHref, pageHref } from "../nav";
import { SITE_DESCRIPTION } from "../seo";

const base = import.meta.env.BASE_URL;
const tracks = await navTracks();
const chapterCount = tracks.reduce(
  (n, track) =>
    n +
    track.sections.reduce(
      (m, section) => m + section.groups.reduce((k, group) => k + group.members.length, 0),
      0,
    ),
  0,
);
---

<Base
  title="Zig Guide Live"
  seoTitle="Zig Tutorial: Every Snippet Verified Against Master"
  description={SITE_DESCRIPTION}
>
  <h1>Zig Guide Live</h1>
  <p class="lede">
    A tutorial for the Zig programming language where <strong>every snippet is
    compiled and executed against current Zig master on every build</strong>. If
    an example on this site were out of date, the build would be red.
  </p>
  <p>
    Snippets run in your browser as WebAssembly: the very same artifact CI
    verified. No server, nothing to install.
  </p>
  <p>
    Zig moves fast, and documentation that is merely proofread rots quietly.
    This one is re-verified against a fresh compiler nightly, and republishes
    itself only when every snippet still passes. Already on a tagged release?
    See <a href={pageHref("getting-started/coming-from-older-zig")}>what changed</a>.
  </p>
  <p>
    <a href={guideHref}>Read the guide →</a>
    {" or "}
    <a href={`${base}paths/`}>pick a reading path</a>.
  </p>

  <h2>What is in it</h2>
  <p>
    {chapterCount} chapters in four tracks, in one reading order. The arrows at
    the foot of every page follow that order, so the whole guide is one walk if
    you want it to be.
  </p>
  {/* A track has no page of its own, on purpose, so each one links to where it
      begins. That is the same place the sidebar and the pager would take you. */}
  <ul class="section-index">
    {
      tracks.map((track) => (
        <li>
          <a href={pageHref(track.sections[0].slug)}>{track.title}</a>
          <span>{track.blurb}</span>
        </li>
      ))
    }
  </ul>
  <p><a href={guideHref}>Every section, in order →</a></p>
</Base>
