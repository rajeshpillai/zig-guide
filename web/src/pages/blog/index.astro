---
/**
 * The blog: every post, newest first.
 *
 * Outside the sidebar and the pager, on the same terms as `/whats-new/`. The
 * sidebar is the guide, and a post is not a stop in the guide: it is dated and
 * it is not rewritten when Zig master moves. See `content.config.ts`.
 */
import Base from "../../layouts/Base.astro";
import { blogHref, postDay, postHref, posts, readableDate } from "../../blog";

const list = await posts();

const description =
  "Essays, notes on what changed in Zig master, and tutorials that do not " +
  "fit a chapter. Each post names the Zig compiler that it was written against.";
---

<Base
  title="Blog"
  seoTitle="Zig Blog: Notes on Zig Master, Essays and Tutorials"
  description={description}
  crumbs={[{ label: "Blog" }]}
  schema={{
    "@type": "Blog",
    name: "Zig Guide Live blog",
    description,
    blogPost: list.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      datePublished: post.data.date,
      url: new URL(postHref(post), Astro.site).href,
    })),
  }}
>
  <article>
    <h1>Blog</h1>
    <p class="section-intro">
      Posts about Zig. Each post has a date and a named compiler. Every night,
      CI keeps the chapters of the guide current, but not the posts. Each post
      shows the Zig version that it was written against, so you can see the age
      of the post. For a feed reader, the posts are at{" "}
      <a href={`${blogHref}rss.xml`}>blog/rss.xml</a>.
    </p>

    <ol class="post-list">
      {
        list.map((post) => (
          <li>
            <p class="post-list-meta">
              <time datetime={post.data.date}>{readableDate(postDay(post))}</time>
              {" · "}Zig {post.data.zig}
            </p>
            <h2>
              <a href={postHref(post)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </article>
</Base>
