---
/**
 * One blog post.
 *
 * The line under the title is the point of the page design. It names the
 * compiler the post was written against, and when that is not the compiler
 * this build verified, it says which code on the page is still checked and
 * which is not. A post's plain code blocks are never re-checked, and a reader
 * deserves to know that before they paste one.
 */
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Playground from "../../components/Playground.astro";
import RiddleBreak from "../../components/RiddleBreak.astro";
import { blogHref, posts, postDay, readableDate, hasCheckedCode, hasPlainCode, type Post } from "../../blog";
import { datesFor } from "../../git-dates";
import { buildInfo } from "../../build-info";
import { AUTHOR, SITE_NAME } from "../../seo";

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { zigVersion } = await buildInfo();

// Published is the date in the frontmatter. Modified comes from git, and only
// counts when it is later than that day: a post committed on `dev` before it
// shipped has an older commit, which is not an edit.
const dates = await datesFor(post.filePath ?? "");
const modified = dates && dates.modified.slice(0, 10) > postDay(post) ? dates.modified : undefined;

const checked = hasCheckedCode(post);
const plain = hasPlainCode(post);
const moved = post.data.zig !== zigVersion;
---

<Base
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  description={post.data.description}
  crumbs={[{ label: "Blog", href: blogHref }, { label: post.data.title }]}
  schema={{
    "@type": "BlogPosting",
    headline: post.data.seoTitle ?? post.data.title,
    description: post.data.description,
    inLanguage: "en",
    author: { "@type": "Person", name: AUTHOR },
    publisher: { "@type": "Organization", name: SITE_NAME },
    datePublished: post.data.date,
    ...(modified ? { dateModified: modified } : {}),
  }}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="chapter-meta">
      <time datetime={post.data.date}>{readableDate(postDay(post))}</time>
      {" · "}Written against Zig {post.data.zig}
    </p>
    {
      moved && (checked || plain) && (
        <p class="post-age">
          {checked && plain && (
            <>
              CI checks the runnable examples on this page every night, and
              they currently run on Zig {zigVersion}. Nothing checks the plain
              code blocks, and they may not compile now.
            </>
          )}
          {checked && !plain && (
            <>CI checks the runnable examples on this page every night, and they currently run on Zig {zigVersion}.</>
          )}
          {!checked && plain && (
            <>
              Nothing checks the code on this page against newer compilers.
              CI currently verifies the guide against Zig {zigVersion}, and
              the code on this page may not compile on that version.
            </>
          )}
        </p>
      )
    }
    <Content components={{ Playground }} />
  </article>

  <RiddleBreak path={`blog/${post.id}`} />

  <p class="post-back">
    <a href={blogHref}>← All posts</a>
  </p>
</Base>
