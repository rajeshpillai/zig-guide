---
/**
 * What's new: the chapters this guide gained, day by day.
 *
 * Additions only. `changelog.ts` keeps a commit only when it added a page a
 * reader can open, which is what leaves out the theming, the tooling, the SEO
 * plumbing and the repository's own house rules. A reader arriving here wants
 * to know what there is to read that was not here last time.
 *
 * Derived, never hand-maintained: the chapters named in a commit are resolved
 * against the content collection here. One that has since been renamed or
 * deleted is shown as plain text rather than as a link, because history is full
 * of paths that no longer resolve and a dead link on this page would be worse
 * than a missing one.
 *
 * Outside the sidebar and the pager, on the same terms as `/paths/`: a view of
 * the guide rather than a stop in it.
 */
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { changelog } from "../changelog";
import { buildInfo } from "../build-info";
import { pageHref, guideHref } from "../nav";

const days = await changelog();
const { zigVersion, snippetCount } = await buildInfo();

const docs = await getCollection("docs");
const byId = new Map(docs.map((doc) => [doc.id, doc]));

/**
 * Chapters named per entry before the rest become a count. A section arrives in
 * one commit, and a fourteen-chapter section listed in full is a wall that
 * buries the entries either side of it.
 */
const SHOWN = 6;

const readable = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const description =
  "Every chapter added to this Zig guide, day by day, in the order of " +
  "publication, from the history of the repository.";

const schema = {
  "@type": "CollectionPage",
  name: "What's new",
  description,
};
---

<Base
  title="What's new"
  seoTitle="What's New in the Zig Guide"
  description={description}
  crumbs={[{ label: "What's new" }]}
  schema={schema}
>
  <article>
    <h1>What's new</h1>
    <p class="section-intro">
      New chapters, in the order of publication. The build makes this list
      from the history of the repository. Thus the list shows what shipped,
      not what a person remembered to write down. The guide currently uses
      <strong>Zig {zigVersion}</strong>. Before this page existed, CI compiled
      and ran all {snippetCount} snippets against that build.
    </p>

    {
      days.length === 0 ? (
        <p>
          This build has no history to read. It was made from a shallow clone,
          or from a source tarball with no <code>.git</code> directory. The
          site itself has no problem, and a full checkout restores the list.
        </p>
      ) : (
        days.map((day) => (
          <section class="release">
            <h2>
              <time datetime={day.date}>{readable(day.date)}</time>
            </h2>
            <ul class="release-list">
              {day.entries.map((entry) => (
                <li>
                  <p class="release-subject">{entry.subject}</p>
                  <p class="release-touched">
                    {/* The count, not a badge per chapter: every chapter in an
                        entry is an addition, so a row of "new" labels would say
                        the same thing as many times as there are links. */}
                    <span class="release-badge">
                      {entry.chapters.length === 1
                        ? "1 chapter"
                        : `${entry.chapters.length} chapters`}
                    </span>
                    {entry.chapters.slice(0, SHOWN).map(({ id }) => {
                      const doc = byId.get(id);
                      return (
                        <span class="release-chapter">
                          {doc ? (
                            <a href={pageHref(id)}>{doc.data.title}</a>
                          ) : (
                            <span class="release-gone">{id}</span>
                          )}
                        </span>
                      );
                    })}
                    {entry.chapters.length > SHOWN && (
                      <span class="release-meta">
                        and {entry.chapters.length - SHOWN} more
                      </span>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }

    <p class="release-foot">
      Older changes are in the history of the repository. The nightly build
      runs at 06:00 UTC against Zig master. The same list, for a feed reader, is
      at <a href={`${import.meta.env.BASE_URL}rss.xml`}>rss.xml</a>. The guide
      itself starts at <a href={guideHref}>the section list</a>.
    </p>
  </article>
</Base>
