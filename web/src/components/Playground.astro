---
/**
 * Renders a snippet from `snippets/` as a runnable block.
 *
 * The source is read from disk at build time and the wasm name is taken from
 * the manifest `zig build` emitted, so a page can never reference a snippet
 * that wasn't compiled and verified.
 */
import { Code } from "astro:components";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

interface Props {
  /** Snippet slug, e.g. `02-language.optionals`. */
  name: string;
  /** Why a `//! norun` snippet can't execute here. Ignored for runnable ones. */
  note?: string;
}

const { name, note } = Astro.props;

// Anchored to the Astro project root (`web/`) rather than `import.meta.url`,
// which points into the bundle output once this component is compiled.
const webRoot = process.cwd();
const manifestPath = resolve(webRoot, "public/wasm/snippets.json");

interface Entry {
  name: string;
  kind: "exe" | "test";
  source: string;
  wasm: string;
  /** False when the snippet needs capabilities the browser sandbox lacks. */
  runnable: boolean;
}

let manifest: Entry[];
try {
  manifest = JSON.parse(await readFile(manifestPath, "utf8"));
} catch {
  throw new Error(
    `web/public/wasm/snippets.json is missing. Run \`zig build\` at the repo ` +
      `root before building the site.`,
  );
}

const entry = manifest.find((e) => e.name === name);
if (!entry) {
  const known = manifest.map((e) => e.name).join(", ");
  throw new Error(`Unknown snippet "${name}". Available: ${known}`);
}

// `entry.source` is stored relative to the repo root, one level above `web/`.
const source = await readFile(resolve(webRoot, "..", entry.source), "utf8");

// Strip the `//!` metadata header; it's for the build, not the reader.
const shown = source.replace(/^(\/\/!.*\n)+\n?/, "").trimEnd();
---

{
  entry.runnable ? (
    <zig-playground
      data-wasm={entry.wasm}
      data-kind={entry.kind}
      data-name={entry.name}
    >
      <Code code={shown} lang="zig" theme="github-dark" />
    </zig-playground>
  ) : (
    <div class="pg-static">
      <div class="pg-toolbar">
        <span class="pg-note">
          {note ?? "Compiled by CI, but not runnable in the browser sandbox."}
        </span>
      </div>
      <Code code={shown} lang="zig" theme="github-dark" />
    </div>
  )
}

<script>
  import "../scripts/playground.ts";
</script>
