---
/**
 * Renders a snippet from `snippets/` as a runnable block.
 *
 * The source is read from disk at build time and the wasm name is taken from
 * the manifest `zig build` emitted, so a page can never reference a snippet
 * that wasn't compiled and verified.
 */
import { existsSync } from "node:fs";
import { Code } from "astro:components";
import { findSnippet, snippetSource } from "../snippets";

/**
 * The same pair `astro.config.mjs` gives fenced blocks in prose. Repeated
 * here because `<Code>` takes its themes as a prop and does not read the
 * markdown config; if the two ever disagreed, a playground would be lit
 * differently from the code fence directly above it.
 */
const CODE_THEMES = {
  light: "github-light-high-contrast",
  dark: "github-dark-high-contrast",
} as const;

interface Props {
  /** Snippet slug, e.g. `02-language.optionals`. */
  name: string;
  /** Why a `//! norun` snippet can't execute here. Ignored for runnable ones. */
  note?: string;
  /**
   * Shell command that runs this snippet on the reader's own machine, for the
   * ones the browser sandbox cannot execute. Omit it when no single command
   * works: the three C-linking snippets `@import("c")`, which only exists
   * because build.zig translates the header, so `zig run` alone would fail.
   */
  tryLocally?: string;
}

const { name, note, tryLocally } = Astro.props;

// Manifest lookup and the `//!` header strip live in `src/snippets.ts`, which
// the plain-markdown routes read too: both have to show a reader and an agent
// the same text.
const entry = await findSnippet(name);
const shown = await snippetSource(entry);

/**
 * Whether this deployment carries the in-browser compiler, decided here rather
 * than discovered by the reader.
 *
 * `zig.wasm` cannot currently be built for `wasm32-wasi`, so most deployments
 * do not have it. Without this flag the page advertises "Run will recompile"
 * on entering the editor, lets the reader write code, and only then fails with
 * a 404 and a message naming a build script they do not have. Reading it at
 * build time costs one `existsSync` and lets the toolbar say what will happen
 * before anything is typed. Resolved against this file rather than the working
 * directory, which differs between `astro dev` and `astro build`.
 */
const canCompile = existsSync(new URL("../../public/compiler/zig.wasm", import.meta.url));
---

{
  entry.runnable ? (
    <zig-playground
      data-wasm={entry.wasm}
      data-kind={entry.kind}
      data-name={entry.name}
      data-can-compile={String(canCompile)}
      data-expect-fail={String(entry.expectFail === true)}
    >
      <Code code={shown} lang="zig" themes={CODE_THEMES} defaultColor={false} />
    </zig-playground>
  ) : (
    <div class="pg-static">
      <div class="pg-toolbar">
        <span class="pg-note">
          {note ?? "Compiled by CI, but not runnable in the browser sandbox."}
        </span>
      </div>
      <Code code={shown} lang="zig" themes={CODE_THEMES} defaultColor={false} />
      {tryLocally && (
        <p class="pg-try">
          <span class="pg-try-label">Run it yourself:</span>
          <code>{tryLocally}</code>
        </p>
      )}
    </div>
  )
}

<script>
  import "../scripts/playground.ts";
</script>
