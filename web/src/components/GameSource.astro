---
/**
 * A block of the game's real source, read off disk at build time.
 *
 * See `src/game-source.ts` for why the chapters quote nothing by hand, and
 * `SourceQuote.astro` for the frame drawn around it.
 */
import SourceQuote from "./SourceQuote.astro";
import { gameSource } from "../game-source";
import { REPO_URL } from "../seo";

interface Props {
  /** Path under `examples/lane-dodger/`, e.g. `src/sim/pool.zig`. */
  file: string;
  /** One declaration out of it. Omit for the whole file. */
  decl?: string;
  /** For a struct that carries methods: show the fields and stop. */
  fields?: boolean;
  /** Highlighting language. Zig unless the file is a shell script. */
  lang?: "zig" | "bash";
}

const { file, decl, fields = false, lang = "zig" } = Astro.props;
const code = await gameSource(file, decl, fields);
const path = `examples/lane-dodger/${file}`;

// `main` rather than a commit: the deployed site is built from `main`, so the
// link shows the same revision the block above was read from.
const href = `${REPO_URL}/blob/main/${path}`;
---

<SourceQuote
  code={code}
  path={path}
  href={href}
  label={decl && `${decl}${fields ? " fields" : ""}`}
  lang={lang}
/>
